{
  "name": "dust",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "serve:test": "ng serve --host 0.0.0.0 --port 4201 --configuration testing",
    "clean": "touch dist/readme.md && rm -r dist/*",
    "build-sources": "yarn run tailwind:build && ng build --base-href /dust/",
    "build": "yarn run clean && yarn run build-sources",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "doc-test": "playwright test",
    "doc-test:dev": "playwright test --ui",
    "tailwind:build": "tailwindcss -i tailwind.config.css -o src/styles/tailwind-build.scss",
    "tailwind:watch": "tailwindcss -i tailwind.config.css -o src/styles/tailwind-build.scss --watch",
    "dev": "concurrently \"yarn start\" \"yarn run serve:test\" \"yarn run tailwind:watch\" \"yarn run start-proxy\"",
    "coverage": "ng test --no-watch --code-coverage",
    "start-proxy": "node cors_proxy/server.js",
    "sonar:scan": "sonar-scanner -Dsonar.projectKey=Dust -Dsonar.host.url=http://localhost:9000 -Dsonar.token=<sonar-token>"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.2.3",
    "@angular/cdk": "^20.2.1",
    "@angular/common": "^20.2.3",
    "@angular/compiler": "^20.2.3",
    "@angular/core": "^20.2.3",
    "@angular/forms": "^20.2.3",
    "@angular/material": "^20.2.1",
    "@angular/material-luxon-adapter": "^20.2.1",
    "@angular/platform-browser": "^20.2.3",
    "@angular/platform-browser-dynamic": "^20.2.3",
    "@angular/router": "^20.2.3",
    "ace-common-components": "^20.0.1",
    "ace-common-util": "1.0.36",
    "immutable": "^5.1.3",
    "luxon": "^3.7.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.2.1",
    "@angular/cli": "^20.2.1",
    "@angular/compiler-cli": "^20.2.3",
    "@endyjasmi/karma-playwright-launcher": "^",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/cli": "^4.1.12",
    "@types/express": "^4.17.23",
    "@types/jasmine": "~5.1.9",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "sonar-scanner": "^3.1.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}